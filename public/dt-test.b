0x200 V6 := 0x01
repeat {
  drawDisplay()
  0x204 READ V4
  0x206 JUMP IF V4 != 0x02
  0x208 V3 += 0x01
  0x20a JUMP IF V4 != 0x08
  0x20c V3 -= V6
} until V4 == 0x05

0x212 DT := V3

repeat {
  V3 := DT
  drawDisplay()
} until V3 == 0x00

0x21c JUMP 0x202
fun drawDisplay() {
  0x21e CLEAR
  0x222 I := 0x23a
  0x224 BCDC V3
  0x226 LOAD 0x2
  0x228 FONT V0
  0x220 V5 := 0x00
  0x22a DRAW V5 V6 0x5
  0x22c FONT V1
  0x22e V5 := 0x05
  0x230 DRAW V5 V6 0x5
  0x232 FONT V2
  0x234 V5 := 0x0a
  0x236 DRAW V5 V6 0x5
  0x238 RETURN
}
