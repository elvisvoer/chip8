goto main;
if (V3 == 0x38) {}
static const byte branchData[] = { 0x50 };

void drawLogo() {
  V0 = 0x04;
  VA = V0;
  V0 = 0x04;
  VB = V0;
  V0 = 0x00;
  I = numberData + 0x03;
  I += V0;
  draw(VA, VB, 0x8);

  V0 = 0x0c;
  VA = V0;
  V0 = 0x04;
  VB = V0;
  I = numberData + 0x0b;
  draw(VA, VB, 0x1);

  V0 = 0x14;
  VA = V0;
  V0 = 0x04;
  VB = V0;
  I = numberData + 0x0b;
  draw(VA, VB, 0x1);

  V0 = 0x80;
  I = numberData + 0x0b;
  save(V0);

  V0 = 0x1c;
  VA = V0;
  V0 = 0x04;
  VB = V0;
  I = numberData + 0x0b;
  draw(VA, VB, 0x1);

  V0 = 0x00;
  V5 = V0;
  V0 = 0xf8;
  V1 = V5;
  I = numberData + 0x03;
  I += V1;
  save(V0);

  V0 = 0x01;
  V5 = V0;
  V0 = 0x00;
  V1 = V5;
  I = numberData + 0x03;
  I += V1;
  save(V0);

  V0 = 0x02;
  V5 = V0;
  V0 = 0xf8;
  V1 = V5;
  I = numberData + 0x03;
  I += V1;
  save(V0);

  V0 = 0x1f;
  VA = V0;
  V0 = 0x07;
  VB = V0;
  V0 = 0x00;
  I = numberData + 0x03;
  I += V0;
  draw(VA, VB, 0x3);
}

main:
drawLogo();
V0 = 0x90;
I = numberData + 0x0d;
save(V0);
V0 = 0x0d;
V3 = V0;
V0 = 0x06;
V4 = V0;
I = numberData + 0x0d;
load(V0);
drawNumber();
V0 = 0x01;
I = numberData + 0x0c;
save(V0);
V0 = 0x00;
I = numberData + 0x0b;
save(V0);

do {
  I = numberData + 0x0d;
  load(V0);
  V5 = V0;
  I = numberData + 0x0c;
  load(V0);
  V1 = V0;
  V0 = V5;
  V0 -= V1;
  I = numberData + 0x0d;
  save(V0);
  I = numberData + 0x0c;
  load(V0);
  V5 = V0;
  V0 = 0x02;
  V1 = V0;
  V0 = V5;
  V0 += V1;
  I = numberData + 0x0c;
  save(V0);
  I = numberData + 0x0b;
  load(V0);
  V5 = V0;
  V0 = 0x01;
  V1 = V0;
  V0 = V5;
  V0 += V1;
  I = numberData + 0x0b;
  save(V0);
  I = numberData + 0x0d;
  load(V0);
  V5 = V0;
  V0 = 0x00;
  V1 = V0;
  V0 = V5;
  V2 = V0;
  V0 -= V1;
  V0 = V2;
  if (V0 == V1) {
    VF = 0x00;
  }
} while (VF != 0x00);
V0 = 0x26;
V3 = V0;
V0 = 0x06;
V4 = V0;
I = numberData + 0x0b;
load(V0);
drawNumber();

for (;;) {}

void readDigit() {
  V1 = V0;
  I = numberData + 0x0e;
  V2 = 0x01;
  VE -= V2;
  I += VE;
  load(V0);
}

void multiply() {
  V2 = 0x01;
  V3 = 0x00;

  do {
    V3 += V0;
    V1 -= V2;
  } while (V1 != 0x00);
  V0 = V3;
}

void divide() {
  I = numberData + 0x0e;
  I += VE;
  save(V6);
  V6 = 0x00;

  for (;;) {
    V2 = V0;
    V2 -= V1;
    if (VF != 0x01) { break; }
    V3 = V0;
    V3 >>= V0;
    V4 = V1;
    V5 = 0x01;

    for (;;) {
      V2 = V3;
      V2 -= V4;
      if (VF != 0x01) { break; }
      V4 <<= V0;
      V5 <<= V0;
    }

    V0 -= V4;
    V6 += V5;
  }
  load(V5);
  V0 = V6;
}

void subtractUntilUnderflow() {
  do {
    V2 = V0;
    V0 -= V1;
  } while (VF != 0x00);
  V0 = V2;
}

void drawNumber() {
  I = numberData;
  bcd(V0);
  load(V2);

  font(V0);
  draw(V3, V4, 0x5);
  V3 += 0x06;

  font(V1);
  draw(V3, V4, 0x5);
  V3 += 0x06;

  font(V2);
  draw(V3, V4, 0x5);
}

static const byte numberData[] = {
