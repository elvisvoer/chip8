// CHIP-8 Chipcross converted to TinyC8
hires();
for (;;) {
clear();
I = 0x7d5;
load(V6);
save(V6);
I = chipcrossData;

for (;;) {
  load(VD);
  if (VF == VE) { break; }
  VF += 0x01;
}

loop1:
I = 0x7e3;
save(VD);
VE += 0x01;
V4 = 0x00;
V3 = 0x12;

do {
drawNumber();
V2 = 0x09;
draw(V2, V3, 0x5);
font(V1);
V2 = 0x04;
draw(V2, V3, 0x5);
V3 += 0x06;
} while (V4 != 0x07);
V3 = 0x10;

do {
drawNumber();
V2 = 0x0a;
draw(V3, V2, 0x5);
font(V1);
V2 = 0x03;
draw(V3, V2, 0x5);
V3 += 0x06;
} while (V4 != 0x0e);
I = chipcrossData + 0x183;

for (V0 = 0x0e; V0 != 0x38; V0 += 0x06) {
  for (V1 = 0x11; V1 != 0x35; V1 += 0x0c) {
    draw(V0, V1, 0xc);
  }
}
V0 = 0x0e;
V1 = 0x35;

do {
draw(V0, V1, 0x7);
V0 += 0x06;
} while (V0 != 0x38);
V1 = 0x11;
I = chipcrossData + 0x18a;

do {
draw(V0, V1, 0x6);
V1 += 0x06;
} while (V1 != 0x3b);
draw(V0, V1, 0x1);
V4 = 0x10;
V5 = 0x13;
V6 = 0x00;
I = chipcrossData + 0x109;
draw(V4, V5, 0x3);
I = chipcrossData + 0x17b;

for (V1 = 0x0f; V1 != 0x3b; V1 += 0x0b) {
  for (V0 = 0x4b; V0 != 0x77; V0 += 0x0b) {
    draw(V0, V1, 0x8);
  }
}
V0 = VE;
I = chipcrossData + 0x131;
V1 = 0x4c;
V2 = 0x10;

for (;;) {
if (V0 == 0x01) { break; }
draw(V1, V2, 0x6);
V1 += 0x0b;
V0 += 0xff;
if (V1 != 0x78) { continue; }
V1 = 0x4c;
V2 += 0x0b;

}

loop11:
I = chipcrossData + 0x160;
V0 = 0x4f;
V1 = 0x05;

do {
draw(V0, V1, 0x7);
V0 += 0x08;
VF = 0x07;
I += VF;
} while (V0 != 0x6f);
I = chipcrossData + 0x18a;
V0 = 0x41;
V1 = 0x00;

do {
draw(V0, V1, 0x4);
V1 += 0x04;
} while (V1 != 0x40);

do {
V2 = read();
I = chipcrossData + 0x109;
draw(V4, V5, 0x3);
if (V2 != 0x09) {}
goto loop16;
if (V4 != 0x34) {}
V4 += 0x06;

loop16:
if (V2 != 0x07) {}
goto loop17;
if (V4 != 0x10) {}
V4 += 0xfa;

loop17:
if (V2 != 0x05) {}
goto loop18;
if (V6 == 0x00) {}
goto loop18;
V6 += 0xff;
V5 += 0xfa;

loop18:
if (V2 != 0x08) {}
goto loop19;
if (V6 == 0x06) {}
goto loop19;
V6 += 0x01;
V5 += 0x06;

loop19:
draw(V4, V5, 0x3);
if (V2 != 0x06) {}
goto loop20;
I = chipcrossData + 0x129;
draw(V4, V5, 0x3);
I = 0x7dc;
I += V6;
load(V0);
V1 = V4;
V2 = 0x01;

for (;;) {
  if (V1 == 0x34) { break; }
  V1 += 0x06;
  V2 <<= V2;
}

loop21:
V0 ^= V2;
I = 0x7dc;
I += V6;
save(V0);

loop20:
VF = 0x00;
saveFlags(V7);
I = 0x7dc;
load(VD);
if (V0 != V7) {}
VF = 0x01;
if (V1 != V8) {}
VF = 0x01;
if (V2 != V9) {}
VF = 0x01;
if (V3 != VA) {}
VF = 0x01;
if (V4 != VB) {}
VF = 0x01;
if (V5 != VC) {}
VF = 0x01;
if (V6 != VD) {}
VF = 0x01;
loadFlags(V7);
} while (VF != 0x00);
waitForSound();
if (VE != 0x10) { continue; }
I = chipcrossData + 0x131;
V1 = 0x6d;
V2 = 0x31;
draw(V1, V2, 0x6);
waitForSound();

for (;;) {
I = chipcrossData + 0x129;
V4 = rand(0xff);
V5 = rand(0xff);
draw(V4, V5, 0x1);
draw(V5, V4, 0x1);
}

}

void waitForSound() {
  VF = 0x3c;
  ST = VF;
  DT = VF;

do {
  VF = DT;
} while (VF != 0x00);
}

void drawNumber() {
  I = 0x7e3;
  I += V4;
  V4 += 0x01;
  load(V0);
  I = chipcrossData + 0xe0;
  I += V0;
  load(V0);
  I = 0xd48;
  bcd(V0);
  load(V2);
  font(V2);
}

