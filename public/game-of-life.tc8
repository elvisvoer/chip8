// 16x16 toroidal board, rendered as 4x2 pixel cells.
goto main;

void countNeighbor() {
  load(V0);
  if (V0 != 0x00) {
    V4 += 0x01;
  }
}

void updateGeneration() {
  V3 = 0x00;
  VC = 0x0f;

  for (V2 = 0x00; V2 != 0x10; V2 += 0x01) {
    V7 = V3;
    V7 += 0xf0;
    V8 = V3;
    V8 += 0x10;

    for (V1 = 0x00; V1 != 0x10; V1 += 0x01) {
      V9 = V1;
      V9 += 0xff;
      V9 &= VC;
      VA = V1;
      VA += 0x01;
      VA &= VC;
      V4 = 0x00;

      I = lifeCurrent;
      I += V7;
      I += V9;
      countNeighbor();
      I = lifeCurrent;
      I += V7;
      I += V1;
      countNeighbor();
      I = lifeCurrent;
      I += V7;
      I += VA;
      countNeighbor();
      I = lifeCurrent;
      I += V3;
      I += V9;
      countNeighbor();
      I = lifeCurrent;
      I += V3;
      I += VA;
      countNeighbor();
      I = lifeCurrent;
      I += V8;
      I += V9;
      countNeighbor();
      I = lifeCurrent;
      I += V8;
      I += V1;
      countNeighbor();
      I = lifeCurrent;
      I += V8;
      I += VA;
      countNeighbor();

      I = lifeCurrent;
      I += V3;
      I += V1;
      load(V0);
      VB = V0;
      V0 = 0x00;
      if (V4 == 0x03) {
        V0 = 0x01;
      } else if (V4 == 0x02) {
        V0 = VB;
      }

      I = lifeNext;
      I += V3;
      I += V1;
      save(V0);
    }

    V3 += 0x10;
  }
}

void copyGeneration() {
  V3 = 0x00;

  for (V2 = 0x00; V2 != 0x10; V2 += 0x01) {
    for (V1 = 0x00; V1 != 0x10; V1 += 0x01) {
      I = lifeNext;
      I += V3;
      I += V1;
      load(V0);
      I = lifeCurrent;
      I += V3;
      I += V1;
      save(V0);
    }

    V3 += 0x10;
  }
}

void drawGeneration() {
  clear();
  V3 = 0x00;
  V6 = 0x00;

  for (V2 = 0x00; V2 != 0x10; V2 += 0x01) {
    V5 = 0x00;

    for (V1 = 0x00; V1 != 0x10; V1 += 0x01) {
      I = lifeCurrent;
      I += V3;
      I += V1;
      load(V0);
      if (V0 == 0x01) {
        I = lifeCell;
        draw(V5, V6, 0x2);
      }
      V5 += 0x04;
    }

    V3 += 0x10;
    V6 += 0x02;
  }
}

main:
drawGeneration();

for (;;) {
  updateGeneration();
  copyGeneration();
  drawGeneration();

  V0 = 0x06;
  DT = V0;
  do {
    V0 = DT;
  } while (V0 != 0x00);
}

