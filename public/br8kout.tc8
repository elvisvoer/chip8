goto main;

static const byte bricks[] = {
  0xfc, 0xfc, 0x80
};

void drawLeftBrick() {
  I = bricks;
  draw(VD, VC, 0x1);
}

void drawRightBrick() {
  I = bricks + 0x02;
  draw(VB, VA, 0x1);
}

void drawBrickField() {
  I = bricks + 0x01;
  V0 = 0x02;

  do {
    V1 = 0x05;
    do {
      V7 = V0;
      V6 = V1;
      draw(V6, V7, 0x1);
      V1 += 0x08;
      VF = 0x38;
      VF ~= V1;
    } while (VF == 0x00);

    V0 += 0x02;
    VF = 0x10;
    VF ~= V0;
  } while (VF == 0x00);
}

void movePaddleDown() {
  drawLeftBrick();
  VD += 0x04;
  drawLeftBrick();
}

void movePaddleUp() {
  drawLeftBrick();
  VD += 0xfc;
  drawLeftBrick();
}

void bounceBall() {
  V0 = V8;
  if (V0 == 0x01) {
    V8 = 0xff;
  }
  if (V0 == 0xff) {
    V8 = 0x01;
  }
  if (VA != VC) {
    checkCollision();
  }
}

void checkCollision() {
  V0 = VB;
  V0 += 0xfb;
  V1 = 0xf8;
  V0 &= V1;
  V0 += 0x05;
  I = bricks + 0x01;
  draw(V0, VA, 0x1);
}

void moveBall() {
  drawRightBrick();
  VB += V9;
  VA += V8;
  drawRightBrick();

  if (VB == 0x00) {
    V9 = 0x01;
  }
  if (VB == 0x3f) {
    V9 = 0xff;
  }
  if (VA == 0x00) {
    V8 = 0x01;
  }
  if (VA == 0x1f) {
    V8 = 0xff;
  }
  if (VF == 0x01) {
    bounceBall();
  }
  if (VA == 0x1f) {
    clearScreen();
  }
}

void clearScreen() {
  clear();
  VB = 0x1e;
  VA = 0x14;
  drawLeftBrick();
  drawRightBrick();
  drawBrickField();
}

void waitForTimer() {
  do {
    VE = DT;
  } while (VE != 0x00);
  VE = 0x04;
  DT = VE;
}

main:
VD = 0x1e;
VC = 0x1e;
VB = 0x40;
VA = 0x1d;
V9 = rand(0x01);
if (V9 == 0x00) {
  V9 = 0xff;
}
V8 = 0xff;
drawLeftBrick();
drawRightBrick();
drawBrickField();

for (;;) {
  V0 = 0x07;
  if (KEY == V0) {
    movePaddleUp();
  }
  V0 = 0x09;
  if (KEY == V0) {
    movePaddleDown();
  }
  moveBall();
  waitForTimer();
}
