goto gameInit;

mainLoop:
V0 = 0x03;
DT = V0;
I = paddleSprite;

V0 = 0x0a;
if (KEY == V0) {
    draw(V7, V8, 0x6);
    V8++;
    draw(V7, V8, 0x6);
} else {
    V0 = 0x0b;
    if (KEY == V0) {
        draw(V7, V8, 0x6);
        V8--;
        draw(V7, V8, 0x6);
    }
}

V0 = 0x08;
if (KEY == V0) {
    draw(V9, VA, 0x6);
    VA++;
    draw(V9, VA, 0x6);
} else {
    V0 = 0x02;
    if (KEY == V0) {
        draw(V9, VA, 0x6);
        VA--;
        draw(V9, VA, 0x6);
    }
}

I = ballSprite;
draw(V3, V4, 0x1);
ballUpdate:
V3 += V5;
V4 += V6;
if (V3 == 0x00) {
    goto resetBall;
}
if (V3 == 0x3f) {
    goto resetBall;
}
if (V4 == 0x00) {
    V6 = 0x01;
}
if (V4 == 0x1f) {
    V6 = 0xff;
}
if (draw(V3, V4, 0x1) != 0x01) {
    goto gameOver;
}
if (V3 == 0x02) {
    V5 = 0x01;
}
if (V3 == 0x3e) {
    V5 = 0xff;
}
draw(V3, V4, 0x1);
V0 = 0xc8;
ST = V0;
goto ballUpdate;

gameOver:
V0 = 0x0f;
if (KEY != V0) {
    goto mainLoop;
}

gameInit:
V7 = 0x02;
V8 = 0x0a;
V9 = 0x3e;
VA = 0x0a;

resetBall:
V3 = 0x20;
V4 = 0x10;
0x27e RAND V5 0x01;
if (V5 != 0x00) {
    V5 = 0xff;
} else {
    V5 = 0x01;
}
0x28a RAND V6 0x01;
if (V6 != 0x00) {
    V6 = 0xff;
} else {
    V6 = 0x01;
}
clear();
I = paddleSprite;
draw(V7, V8, 0x6);
draw(V9, VA, 0x6);
I = ballSprite;
draw(V3, V4, 0x1);

waitForPress:
V0 = 0x0f;
if (KEY != V0) {
    goto waitForPress;
}

waitForRelease:
if (KEY == V0) {
    goto waitForRelease;
} else {
    goto mainLoop;
}

static const byte paddleSprite[] = {
    0x80, 0x80, 0x80, 0x80, 0x80, 0x80
};

static const byte ballSprite[] = { 0x80, 0x00 };
