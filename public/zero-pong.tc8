goto gameInit

mainLoop:
V0 := 0x03
DT := V0
I := 0x2b0

V0 := 0x0a
if (KEY == V0) {
    0x20e DRAW V7 V8 0x6
    V8 += 0x01
    0x212 DRAW V7 V8 0x6
} else {
    V0 := 0x0b
    if (KEY == V0) {
        0x21c DRAW V7 V8 0x6
        V8 += 0xff
        0x220 DRAW V7 V8 0x6
    }
}

V0 := 0x08
if (KEY == V0) {
    0x228 DRAW V9 VA 0x6
    VA += 0x01
    0x22c DRAW V9 VA 0x6
} else {
    V0 := 0x02
    if (KEY == V0) {
        0x236 DRAW V9 VA 0x6
        VA += 0xff
        0x23a DRAW V9 VA 0x6
    }
}

I := 0x2b6
0x23e DRAW V3 V4 0x1
ballUpdate:
V3 += V5
V4 += V6
if (V3 == 0x00) {
    goto resetBall
}
if (V3 == 0x3f) {
    goto resetBall
}
if (V4 == 0x00) {
    V6 := 0x01
}
if (V4 == 0x1f) {
    V6 := 0xff
}
0x254 DRAW V3 V4 0x1
if (VF != 0x01) {
    goto gameOver
}
if (V3 == 0x02) {
    V5 := 0x01
}
if (V3 == 0x3e) {
    V5 := 0xff
}
0x262 DRAW V3 V4 0x1
V0 := 0xc8
ST := V0
goto ballUpdate

gameOver:
V0 := 0x0f
if (KEY != V0) {
    goto mainLoop
}

gameInit:
V7 := 0x02
V8 := 0x0a
V9 := 0x3e
VA := 0x0a

resetBall:
V3 := 0x20
V4 := 0x10
0x27e RAND V5 0x01
if (V5 != 0x00) {
    V5 := 0xff
} else {
    V5 := 0x01
}
0x28a RAND V6 0x01
if (V6 != 0x00) {
    V6 := 0xff
} else {
    V6 := 0x01
}
0x296 CLEAR
I := 0x2b0
0x29a DRAW V7 V8 0x6
0x29c DRAW V9 VA 0x6
I := 0x2b6
0x2a0 DRAW V3 V4 0x1

waitForPress:
V0 := 0x0f
if (KEY != V0) {
    goto waitForPress
}

waitForRelease:
if (KEY == V0) {
    goto waitForRelease
} else {
    goto mainLoop
}

paddleSprite:
0x2b0 0x8080
0x2b2 0x8080
0x2b4 0x8080

ballSprite:
