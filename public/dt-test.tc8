V6 = 0x01;

for (;;) {
  do {
    drawDisplay();
    V4 = read();

    if (V4 == 0x02) {
      V3 += 0x01;
    }

    if (V4 == 0x08) {
      V3 -= V6;
    }
  } while (V4 != 0x05);

  DT = V3;

  do {
    V3 = DT;
    drawDisplay();
  } while (V3 != 0x00);
}

void drawDisplay() {
  clear();

  I = 0x23a;
  bcd(V3);
  load(V2);

  font(V0);
  V5 = 0x00;
  draw(V5, V6, 0x5);

  font(V1);
  V5 = 0x05;
  draw(V5, V6, 0x5);

  font(V2);
  V5 = 0x0a;
  draw(V5, V6, 0x5);
}
