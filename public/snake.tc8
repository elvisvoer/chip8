void drawString() {
  I = 0x5bc;
  save(V1);
  V1 = V5;
  V2 = V6;
  V3 = 0x00;

do {
  noop();
  I += V3;
  load(V0);
  V5 = V0;
  I = snakeAssets + 0x202;
  VE = 0x05;
  if (V0 != 0x00) {}
  advanceText();
  draw(V1, V2, 0x5);
  V1 += 0x05;
  if (V5 == 0x16) {}
  V1 += 0x01;
  if (V5 == 0x26) {}
  V1 += 0x01;
  if (V5 == 0x2b) {}
  V1 += 0xff;
  if (V5 == 0x2d) {}
  V1 += 0xff;
  V3 += 0x01;
} while (V3 != V4);
}

void advanceText() {
  do {
    I += VE;
    V0 += 0xff;
  } while (V0 != 0x00);
}

void saveSnake() {
  V9 += 0x01;
  I = snakeAssets + 0x2;
  I += V9;
  I += V9;
  V0 = VA;
  V1 = VB;
  save(V1);
}

void loadSnake() {
  V2 = V9;
  V2 -= VD;
  I = snakeAssets + 0x2;
  I += V2;
  I += V2;
  load(V1);
}

void spawnFood() {
  VD += 0x01;
  V7 = rand(0x3f);
  V8 = rand(0x1f);
}

void drawNumber() {
  V1 = 0x00;
  V2 = 0x00;
  V3 = 0x00;
  if (V0 == 0x00) {}
  goto loop4;

  do {
    V0 += 0xff;
    V1 += 0x01;
    if (V1 != 0x0a) { continue; }
    V1 = 0x00;
    V2 += 0x01;
    if (V2 != 0x0a) { continue; }
    V2 = 0x00;
    V3 += 0x01;
  } while (V0 != 0x00);

loop4:
  font(V1);
  VA = 0x37;
  draw(VA, VB, 0x5);
  font(V2);
  VA = 0x31;
  draw(VA, VB, 0x5);
  font(V3);
  VA = 0x2b;
  draw(VA, VB, 0x5);
}

