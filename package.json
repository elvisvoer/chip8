{
  "name": "chip8",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest",
    "nearleyc": "nearleyc",
    "ne-asm": "nearleyc src/lib/asm/asm.ne -o src/lib/asm/asm.js",
    "ne-basic": "nearleyc src/lib/basic/basic.ne -o src/lib/basic/basic.js",
    "all": "npm run ne-asm && npm run ne-basic && npm test"
  },
  "devDependencies": {
    "@types/nearley": "^2.11.5",
    "@types/node": "^26.6.5",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "nearley": "^2.20.1"
  }
}
